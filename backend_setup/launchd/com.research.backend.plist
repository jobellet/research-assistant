<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.research.backend</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <!-- Replace /PATH/TO/YOUR/REPO with the absolute path to your repository -->
        <string>/PATH/TO/YOUR/REPO/launch.command</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/PATH/TO/YOUR/REPO/server_auto.log</string>
    <key>StandardErrorPath</key>
    <string>/PATH/TO/YOUR/REPO/server_auto.log</string>
    <key>WorkingDirectory</key>
    <string>/PATH/TO/YOUR/REPO</string>
</dict>
</plist>
