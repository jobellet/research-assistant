<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.research.gdrive_sync</string>
    <key>ProgramArguments</key>
    <array>
        <!-- Replace with path to your conda python -->
        <string>/PATH/TO/CONDA/envs/ai_research_assistant/bin/python</string>
        <string>/PATH/TO/YOUR/REPO/scripts/gdrive_sync.py</string>
    </array>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>StandardOutPath</key>
    <string>/PATH/TO/YOUR/REPO/gdrive_sync.log</string>
    <key>StandardErrorPath</key>
    <string>/PATH/TO/YOUR/REPO/gdrive_sync.log</string>
    <key>WorkingDirectory</key>
    <string>/PATH/TO/YOUR/REPO</string>
</dict>
</plist>
